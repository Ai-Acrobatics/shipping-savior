# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Use the "Transaction pooler" connection string from Supabase Dashboard > Settings > Database
DATABASE_URL=

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth — Google
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
# Create app at https://github.com/settings/developers
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (transactional email — password reset + email verification)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address for outbound auth emails. Use onboarding@resend.dev when no
# custom domain has been verified in Resend; switch to noreply@<verified-domain>
# once DNS is set up.
EMAIL_FROM=onboarding@resend.dev

# Public base URL used to build absolute links inside emails (reset-password,
# verify-email). Falls back to AUTH_URL when not set.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email-verification gate. When `true`, unverified credentials users are
# bounced from /platform/* to /verify-email by middleware. Default `false` so
# we don't break existing accounts.
REQUIRE_EMAIL_VERIFICATION=false

# Anthropic API (for AI chatbot)
ANTHROPIC_API_KEY=

# Stripe billing (AI-8777)
# Server-side secret key (sk_test_... or sk_live_...) — from Stripe dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) — from Stripe dashboard > Developers > Webhooks > [endpoint] > Signing secret
STRIPE_WEBHOOK_SECRET=
# Browser-side publishable key (pk_test_... or pk_live_...) — safe to expose
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs for each paid plan — create products in Stripe dashboard, then paste the price IDs here
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# ── Vessel map / AIS (AI-12012) ───────────────────────────────────────
# Basemap style for MapLibre. Defaults to MapLibre's keyless demo tiles;
# point this at MapTiler/Protomaps/Stadia for production-quality basemaps.
NEXT_PUBLIC_MAP_STYLE_URL=

# AIS position feed. One of: none (default) | aishub | http
# `none` renders every vessel from its ETD/ETA schedule, labelled "Estimated".
AIS_PROVIDER=none
# AISHub username (AIS_PROVIDER=aishub) — https://www.aishub.net
AISHUB_USERNAME=
# Generic REST feed (AIS_PROVIDER=http). Supports {vessels}, {mmsi}, {imo}
# placeholders; without a placeholder the URL is fetched once and filtered.
AIS_API_URL=
AIS_API_KEY=
# Header the key is sent in. "Authorization" (default) sends `Bearer <key>`;
# any other value sends the raw key.
AIS_API_KEY_HEADER=Authorization

# Terminal49 container tracking (AI-12010)
# Get API key at https://dashboard.terminal49.com/settings/api
TERMINAL49_API_KEY=
# Webhook signing secret from Terminal49 dashboard > Webhooks > [endpoint] > Signing secret
# Required in production: the webhook rejects all requests (503) when unset.
# Signature verification is only skipped outside production.
TERMINAL49_WEBHOOK_SECRET=
